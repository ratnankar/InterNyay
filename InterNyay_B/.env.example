DB_URL=jdbc:mysql://localhost:3306/internyay

DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=

# 32+ random characters, only needed to create the first admin (see docs/ADMIN_SETUP.md)
INTERNYAY_ADMIN_SETUP_KEY=

# Frontend addresses allowed to call the API (comma separated). Use the real https address in production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

ECOURTS_API_TOKEN=
# Only if the order endpoint does not return the PDF itself: the document download path, with {cnr} and {filename}
ECOURTS_ORDER_DOWNLOAD_PATH=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_DRY_RUN=false

GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
OTP_DRY_RUN=false

GOOGLE_CLIENT_ID=

CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# File storage: local (default, files in ./data/uploads) or s3 (see docs/STORAGE_SETUP.md)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false

# Set to native when the backend runs behind nginx / a load balancer (so rate limits see each user's real IP); none when it is reached directly
FORWARD_HEADERS_STRATEGY=none

# Log detail for the app: INFO for production, DEBUG only while investigating
LOG_LEVEL=INFO

# Rate limiting of login, OTP and Google sign-in per client IP (true by default, false only for local debugging)
RATE_LIMIT_ENABLED=true

CAPTCHA_SOLVER_ENABLED=true
CAPTCHA_SOLVER_URL=http://127.0.0.1:8001
CAPTCHA_SOLVER_KEY=
