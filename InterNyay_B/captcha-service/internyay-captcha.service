[Unit]
Description=InterNyay CAPTCHA service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/internyay/captcha-service
EnvironmentFile=-/opt/internyay/captcha-service/.env
ExecStart=/opt/internyay/captcha-service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
